// Halt first so the ring buffer is frozen while reading (read is otherwise torn
// by the 1 kHz writer). IWDG is frozen while halted, so this is safe.
si SWD
device STM32F427II
speed 4000
connect
h
mem32 0x20000474 1
mem32 0x20000468 4
mem32 0x20003CCC 2
mem32 0x20003C7C 1
savebin "C:\Users\Lenovo\Documents\Codex\2026-09-27\gm6020-https-blog-csdn-net-m0\work\scope_h.bin" 0x2000047C 14336
g
exit
